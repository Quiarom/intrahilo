# Opcionales. La demo funciona sin credenciales ni servicios adicionales.
PORT=4310
# INTRAHILO_DB=/ruta/absoluta/intrahilo/var/intrahilo.sqlite
# SOURCES_CONFIG=/ruta/absoluta/intrahilo/sources.json
# 0 desactiva polling automático; el mínimo permitido es 300 segundos.
POLL_INTERVAL_SECONDS=0
# API pública funciona sin token; aumenta límites solo con uno ya autorizado.
# GITHUB_TOKEN=
# Vectorial solo si servicios locales YA están disponibles y modelo instalado.
# OLLAMA_URL=http://127.0.0.1:11434
# QDRANT_URL=http://127.0.0.1:6333
# EMBEDDING_MODEL=embeddinggemma
# No se descargan modelos ni se invoca generación por defecto.
GENERATION_ENABLED=false
# Opt-in explícito con acceso API separado: una suscripción de chat NO es una API key.
# GENERATION_BASE_URL=https://proveedor-autorizado.example/v1/
# GENERATION_MODEL=
# GENERATION_API_KEY=
